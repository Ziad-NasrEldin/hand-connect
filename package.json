{
  "name": "herafy",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "NODE_ENV=test vitest run --exclude 'functions/lib/**'",
    "test:rules": "bash -lc 'export NODE_ENV=test; export JAVA_HOME=\"${JAVA_HOME:-$(brew --prefix openjdk@21 2>/dev/null || true)}\"; export PATH=\"$JAVA_HOME/bin:$PATH\"; ./node_modules/.bin/firebase emulators:exec --only firestore,storage \"./node_modules/.bin/vitest run --environment node --fileParallelism=false tests/rules/firestore.rules.test.ts tests/rules/storage.rules.test.ts\"'",
    "test:watch": "vitest",
    "cap:sync:ios": "npm run build && npx cap sync ios",
    "cap:open:ios": "npx cap open ios",
    "e2e": "NODE_ENV=test playwright test",
    "vercel:build": "npx vercel pull --yes --environment=preview && npx vercel build --yes",
    "vercel:build:production": "npx vercel pull --yes --environment=production && npx vercel build --prod --yes",
    "deploy:preview": "npm run vercel:build && npx vercel deploy --prebuilt",
    "deploy:production": "npm run vercel:build:production && npx vercel deploy --prebuilt --prod",
    "release:check": "npm run lint && npm test && npm run test:rules && npm run build && npm run e2e",
    "firebase:emulators": "firebase emulators:start --import=.firebase-emulator-data --export-on-exit",
    "seed:dev": "tsx scripts/seed-dev.ts",
    "admin:create": "tsx scripts/create-admin.ts",
    "customer:reset": "tsx scripts/reset-customer.ts"
  },
  "dependencies": {
    "@capacitor/cli": "^8.4.0",
    "@capacitor/core": "^8.4.0",
    "@capacitor/ios": "^8.4.0",
    "@fontsource/archivo-black": "^5.2.8",
    "@fontsource/cairo": "^5.2.7",
    "@fontsource/source-sans-3": "^5.2.9",
    "@hookform/resolvers": "^5.0.1",
    "@radix-ui/react-avatar": "^1.1.10",
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-select": "^2.2.5",
    "@radix-ui/react-slot": "^1.2.3",
    "@tanstack/react-query": "^5.75.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "firebase": "^11.7.1",
    "gsap": "^3.15.0",
    "i18next": "^25.1.1",
    "lucide-react": "^0.510.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-hook-form": "^7.56.3",
    "react-i18next": "^15.5.2",
    "react-router-dom": "^7.6.0",
    "recharts": "^2.15.3",
    "tailwind-merge": "^3.3.0",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^3.24.4",
    "zustand": "^5.0.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.26.0",
    "@firebase/rules-unit-testing": "^4.0.1",
    "@playwright/test": "^1.52.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.15.17",
    "@types/react": "^19.1.3",
    "@types/react-dom": "^19.1.3",
    "@vercel/node": "^5.3.24",
    "@vitejs/plugin-react": "^4.4.1",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.26.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "firebase-tools": "^14.3.1",
    "globals": "^16.1.0",
    "jsdom": "^26.1.0",
    "postcss": "^8.5.3",
    "prettier": "^3.5.3",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.32.1",
    "vite": "^6.3.5",
    "vitest": "^3.1.3"
  }
}
