rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function role() {
      return signedIn() ? userDoc().data.role : null;
    }

    function isAdmin() {
      return signedIn() && role() == 'admin' && userDoc().data.status != 'banned';
    }

    function activeUser() {
      return signedIn() && userDoc().data.status != 'banned';
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function ownsProvider(providerId) {
      return signedIn()
        && get(/databases/$(database)/documents/providers/$(providerId)).data.userId == request.auth.uid;
    }

    function providerOwnerActive(provider) {
      return exists(/databases/$(database)/documents/users/$(provider.data.userId))
        && get(/databases/$(database)/documents/users/$(provider.data.userId)).data.status != 'banned';
    }

    function policyCoverageRadius(profession, serviceAreaKey) {
      return serviceAreaKey in ['new-cairo', 'shorouk'] ? 14
        : profession == 'plumbing' ? 12
        : profession == 'electrical' ? 10
        : profession == 'cleaning' ? 5
        : 8;
    }

    function hasPolicyCoverageRadius(provider) {
      return provider.coverageRadiusKm == policyCoverageRadius(
        provider.profession,
        provider.initialServiceAreaKey
      );
    }

    function providerCreateKeysAreSafe() {
      return request.resource.data.keys().hasOnly([
        'userId',
        'id',
        'ownerStatus',
        'displayName',
        'phone',
        'profession',
        'bio',
        'nationalIdVerified',
        'status',
        'serviceAreas',
        'serviceAreaKeys',
        'initialServiceAreaKey',
        'coverageRadiusKm',
        'coverageAreaKeys',
        'whatsappNumber',
        'whatsappVisible',
        'visibilityTier',
        'visibilityPaidUntil',
        'paidVisibilityStartedAt',
        'activeVisibilityRequestId',
        'activeVisibilityProductId',
        'activeVisibilityProductVersion',
        'paidVisibilityHoldUntil',
        'rankingPenalty',
        'rankingPenaltyUntil',
        'verificationStatus',
        'verificationReviewedAt',
        'verificationReviewedBy',
        'verificationNotes',
        'profileViews',
        'avgRating',
        'reviewCount',
        'activityScore',
        'photos',
        'createdAt',
        'approvedAt'
      ]);
    }

    function providerCreateValuesAreSafe(providerId) {
      return request.resource.data.userId == request.auth.uid
        && request.resource.data.id == providerId
        && request.resource.data.ownerStatus == 'active'
        && request.resource.data.status == 'pending'
        && request.resource.data.nationalIdVerified == false
        && request.resource.data.serviceAreaKeys is list
        && request.resource.data.serviceAreaKeys.size() == 1
        && request.resource.data.initialServiceAreaKey == request.resource.data.serviceAreaKeys[0]
        && request.resource.data.coverageAreaKeys is list
        && request.resource.data.coverageAreaKeys.hasAll(request.resource.data.serviceAreaKeys)
        && request.resource.data.serviceAreas is list
        && request.resource.data.serviceAreas.size() == 1
        && request.resource.data.serviceAreas[0].city == 'cairo'
        && request.resource.data.serviceAreas[0].neighborhood == request.resource.data.initialServiceAreaKey
        && request.resource.data.visibilityTier == 'organic'
        && request.resource.data.visibilityPaidUntil == null
        && request.resource.data.paidVisibilityStartedAt == null
        && request.resource.data.activeVisibilityRequestId == null
        && request.resource.data.activeVisibilityProductId == null
        && request.resource.data.activeVisibilityProductVersion == null
        && request.resource.data.paidVisibilityHoldUntil == null
        && request.resource.data.rankingPenalty == 0
        && request.resource.data.rankingPenaltyUntil == null
        && request.resource.data.verificationStatus == 'submitted'
        && request.resource.data.verificationReviewedAt == null
        && request.resource.data.verificationReviewedBy == null
        && request.resource.data.verificationNotes == null
        && request.resource.data.profileViews == 0
        && request.resource.data.avgRating == 0
        && request.resource.data.reviewCount == 0
        && request.resource.data.activityScore == 0
        && request.resource.data.photos is list
        && request.resource.data.approvedAt == null
        && hasPolicyCoverageRadius(request.resource.data);
    }

    function visibilitySnapshotKeysAreSafe() {
      return request.resource.data.productSnapshot is map
        && request.resource.data.productSnapshot.keys().hasOnly([
          'productId',
          'productVersion',
          'productType',
          'durationDays',
          'priceAmount',
          'currency',
          'billingModel',
          'capPolicy',
          'paymentProvider',
          'renewalPolicy',
          'snapshotAt'
        ]);
    }

    function boostSnapshotIsTrusted() {
      return request.resource.data.productSnapshot.productId == 'visibility_boost_30_paymob'
        && request.resource.data.productSnapshot.productVersion == 2
        && request.resource.data.productSnapshot.productType == 'visibility_boost'
        && request.resource.data.productSnapshot.durationDays == 30
        && request.resource.data.productSnapshot.priceAmount == 500
        && request.resource.data.productSnapshot.currency == 'EGP'
        && request.resource.data.productSnapshot.billingModel == 'pay_as_you_go'
        && request.resource.data.productSnapshot.capPolicy == 'none'
        && request.resource.data.productSnapshot.paymentProvider == 'paymob'
        && request.resource.data.productSnapshot.renewalPolicy == 'none'
        && request.resource.data.productSnapshot.snapshotAt == request.resource.data.requestedAt;
    }

    function areaExpansionSnapshotIsTrusted() {
      return request.resource.data.productSnapshot.productId == 'area_expansion_30_paymob'
        && request.resource.data.productSnapshot.productVersion == 2
        && request.resource.data.productSnapshot.productType == 'area_expansion'
        && request.resource.data.productSnapshot.durationDays == 30
        && request.resource.data.productSnapshot.priceAmount == 250
        && request.resource.data.productSnapshot.currency == 'EGP'
        && request.resource.data.productSnapshot.billingModel == 'monthly_auto_renew'
        && request.resource.data.productSnapshot.capPolicy == 'coverage_only'
        && request.resource.data.productSnapshot.paymentProvider == 'paymob'
        && request.resource.data.productSnapshot.renewalPolicy == 'auto_charge_card'
        && request.resource.data.productSnapshot.snapshotAt == request.resource.data.requestedAt;
    }

    function visibilityRequestSnapshotIsTrusted() {
      return visibilitySnapshotKeysAreSafe()
        && (
          (request.resource.data.type == 'boost' && boostSnapshotIsTrusted())
          || (request.resource.data.type == 'area_expansion' && areaExpansionSnapshotIsTrusted())
        );
    }

    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId)
        && request.resource.data.role in ['customer', 'provider']
        && request.resource.data.status == 'active';
      allow update: if isOwner(userId)
        && activeUser()
        && request.resource.data.role == resource.data.role
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.status == resource.data.status
        && request.resource.data.banReason == resource.data.banReason
        && request.resource.data.bannedAt == resource.data.bannedAt
        && request.resource.data.bannedBy == resource.data.bannedBy;
      allow delete: if false;
    }

    match /providers/{providerId} {
      allow read: if (
          resource.data.status == 'approved'
          && providerOwnerActive(resource)
        ) || (activeUser() && isOwner(resource.data.userId)) || isAdmin();
      allow create: if activeUser()
        && providerCreateKeysAreSafe()
        && providerCreateValuesAreSafe(providerId);
      allow update: if isAdmin()
        || (activeUser()
          && isOwner(resource.data.userId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'displayName',
            'phone',
            'profession',
            'bio',
            'whatsappNumber',
            'whatsappVisible',
            'photos'
          ]));
      allow delete: if false;
    }

    match /providerIdentityDocuments/{documentId} {
      allow read: if isAdmin() || isOwner(resource.data.providerId);
      allow create: if activeUser() && request.resource.data.providerId == request.auth.uid;
      allow update: if isAdmin() || (activeUser() && isOwner(resource.data.providerId));
      allow delete: if false;
    }

    match /professions/{professionId} {
      allow read: if true;
      allow write: if false;
    }

    match /contacts/{contactId} {
      allow read: if isAdmin() || isOwner(resource.data.customerId) || isOwner(resource.data.providerId);
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    match /conversations/{conversationId} {
      allow read: if activeUser() && request.auth.uid in resource.data.participants;
      allow create: if false;
      allow update: if activeUser()
        && request.auth.uid in resource.data.participants
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['unreadCount']);

      match /messages/{messageId} {
        allow read: if activeUser()
          && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants;
        allow create: if false;
        allow update: if activeUser()
          && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants
          && resource.data.senderId != request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read'])
          && request.resource.data.read == true;
      }
    }

    match /reviews/{reviewId} {
      allow read: if resource.data.status == 'visible' || isAdmin();
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    match /visibilityRequests/{requestId} {
      allow read: if isAdmin() || ownsProvider(resource.data.providerId);
      allow create: if activeUser()
        && request.resource.data.keys().hasOnly([
          'providerId',
          'type',
          'tier',
          'serviceArea',
          'status',
          'paymentConfirmedBy',
          'paymentMethod',
          'paymentStatus',
          'paymentReference',
          'productSnapshot',
          'disclosureVersion',
          'disclosureAcceptedAt',
          'notes',
          'requestedAt',
          'processedAt'
        ])
        && request.resource.data.providerId is string
        && ownsProvider(request.resource.data.providerId)
        && request.resource.data.type in ['boost', 'area_expansion']
        && request.resource.data.tier == 'paid'
        && request.resource.data.status == 'pending'
        && request.resource.data.paymentConfirmedBy == null
        && request.resource.data.paymentMethod in ['manual_cash', 'manual_wallet', 'manual_bank_transfer']
        && request.resource.data.paymentStatus == 'pending'
        && request.resource.data.paymentReference == null
        && request.resource.data.processedAt == null
        && request.resource.data.disclosureVersion == 'visibility-no-guarantee-v1'
        && request.resource.data.disclosureAcceptedAt == request.resource.data.requestedAt
        && request.resource.data.notes is string
        && (request.resource.data.requestedAt is timestamp || request.resource.data.requestedAt is string)
        && visibilityRequestSnapshotIsTrusted()
        && (
          (request.resource.data.type == 'boost'
            && request.resource.data.serviceArea in get(/databases/$(database)/documents/providers/$(request.resource.data.providerId)).data.serviceAreaKeys)
          || (request.resource.data.type == 'area_expansion'
            && !(request.resource.data.serviceArea in get(/databases/$(database)/documents/providers/$(request.resource.data.providerId)).data.serviceAreaKeys)
            && get(/databases/$(database)/documents/providers/$(request.resource.data.providerId)).data.reviewCount >= 30)
        );
      allow update: if false;
      allow delete: if false;
    }

    match /analyticsEvents/{eventId} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }

    match /adminActions/{actionId} {
      allow read: if isAdmin();
      allow create: if isAdmin()
        && request.resource.data.adminId == request.auth.uid
        && request.resource.data.targetType in ['provider', 'profession', 'visibilityRequest', 'review', 'report', 'user']
        && request.resource.data.targetId is string
        && request.resource.data.action is string
        && request.resource.data.reason is string
        && (request.resource.data.createdAt is timestamp || request.resource.data.createdAt is string);
      allow update, delete: if false;
    }

    match /reports/{reportId} {
      allow read: if isAdmin();
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }
  }
}
