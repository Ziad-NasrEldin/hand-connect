rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function role() {
      return signedIn() ? userDoc().data.role : null;
    }

    function isAdmin() {
      return signedIn() && role() == 'admin';
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId) && request.resource.data.role in ['customer', 'provider'];
      allow update: if isOwner(userId)
        && request.resource.data.role == resource.data.role
        && request.resource.data.uid == resource.data.uid;
      allow delete: if false;
    }

    match /providers/{providerId} {
      allow read: if resource.data.status == 'approved' || isOwner(resource.data.userId) || isAdmin();
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid && request.resource.data.status == 'pending';
      allow update: if isAdmin()
        || (isOwner(resource.data.userId)
          && request.resource.data.status == resource.data.status
          && request.resource.data.nationalIdVerified == resource.data.nationalIdVerified
          && request.resource.data.visibilityTier == resource.data.visibilityTier);
      allow delete: if false;
    }

    match /providerIdentityDocuments/{documentId} {
      allow read: if isAdmin() || isOwner(resource.data.providerId);
      allow create: if signedIn() && request.resource.data.providerId == request.auth.uid;
      allow update: if isAdmin() || isOwner(resource.data.providerId);
      allow delete: if false;
    }

    match /professions/{professionId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /contacts/{contactId} {
      allow read: if isAdmin() || isOwner(resource.data.customerId) || isOwner(resource.data.providerId);
      allow create: if signedIn() && request.resource.data.customerId == request.auth.uid;
      allow update: if isAdmin()
        || (signedIn()
          && resource.data.customerId == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['hasReview'])
          && resource.data.hasReview == false
          && request.resource.data.hasReview == true);
      allow delete: if false;
    }

    match /conversations/{conversationId} {
      allow read: if signedIn() && request.auth.uid in resource.data.participants;
      allow create: if signedIn() && request.auth.uid in request.resource.data.participants;
      allow update: if signedIn() && request.auth.uid in resource.data.participants;

      match /messages/{messageId} {
        allow read: if signedIn()
          && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants;
        allow create: if signedIn()
          && request.auth.uid == request.resource.data.senderId
          && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants;
      }
    }

    match /reviews/{reviewId} {
      allow read: if resource.data.status == 'visible' || isAdmin();
      allow create: if signedIn()
        && reviewId == request.auth.uid + '_' + request.resource.data.providerId
        && request.resource.data.keys().hasOnly([
          'providerId',
          'customerId',
          'customerName',
          'contactId',
          'rating',
          'comment',
          'status',
          'createdAt'
        ])
        && request.resource.data.customerId == request.auth.uid
        && request.resource.data.rating in [1, 2, 3, 4, 5]
        && request.resource.data.comment is string
        && request.resource.data.comment.size() > 0
        && request.resource.data.comment.size() <= 2000
        && request.resource.data.status == 'visible'
        && exists(/databases/$(database)/documents/contacts/$(request.resource.data.contactId))
        && get(/databases/$(database)/documents/contacts/$(request.resource.data.contactId)).data.customerId == request.auth.uid
        && get(/databases/$(database)/documents/contacts/$(request.resource.data.contactId)).data.providerId == request.resource.data.providerId
        && get(/databases/$(database)/documents/contacts/$(request.resource.data.contactId)).data.hasReview == false
        && get(/databases/$(database)/documents/providers/$(request.resource.data.providerId)).data.status == 'approved';
      allow update: if isAdmin();
      allow delete: if false;
    }

    match /visibilityRequests/{requestId} {
      allow read: if isAdmin() || isOwner(resource.data.providerId);
      allow create: if signedIn();
      allow update: if isAdmin();
      allow delete: if false;
    }

    match /adminActions/{actionId} {
      allow read: if isAdmin();
      allow create: if isAdmin()
        && request.resource.data.adminId == request.auth.uid
        && request.resource.data.targetType in ['provider', 'review', 'report']
        && request.resource.data.targetId is string
        && request.resource.data.action is string
        && request.resource.data.reason is string
        && (request.resource.data.createdAt is timestamp || request.resource.data.createdAt is string);
      allow update, delete: if false;
    }

    match /reports/{reportId} {
      allow read: if isAdmin();
      allow create: if signedIn();
      allow update: if isAdmin();
      allow delete: if false;
    }
  }
}
